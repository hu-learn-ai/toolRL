# ToolRL-Lite 环境变量示例
# 复制为 .env：cp .env.example .env

# ===== Serving 部署（HTTP API / MCP / Docker）=====

# 对外暴露端口（docker-compose：宿主 HOST_PORT -> 容器 8000）
HOST_PORT=8000

# 启动时是否预热 SFT + GRPO_v3 两个模型
# 设为 1：首请求不卡，但启动慢 1-2 分钟
# 设为 0：启动快，首请求约 10-30 秒（按权重加载耗时）
SERVING_WARMUP=1

# Checkpoint 路径（容器内）
# 默认映射到 ./checkpoints/sft 与 ./checkpoints/grpo_v3
# 若 checkpoint 在别处，改这里即可（docker-compose 用 :ro 挂载）
CHECKPOINT_SFT=/app/checkpoints/sft
CHECKPOINT_GRPO_V3=/app/checkpoints/grpo_v3

# HuggingFace 镜像（国内必设，避免直连 hf.co 失败；本地联网训练请按需关闭）
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1
TRANSFORMERS_OFFLINE=1

# ===== Teacher LLM 接入配置（data 合成路径使用，serving 不依赖）=====
# data/config.py 与 data/llm_teacher.py 读取以下变量；正式合成时填入真实值
TEACHER_BASE_URL=https://api.deepseek.com/v1
TEACHER_API_KEY=sk-xxxx
TEACHER_MODEL=deepseek-chat
TEACHER_TEMPERATURE=0.7
TEACHER_MAX_TOKENS=2048
TEACHER_TIMEOUT=60
TEACHER_MAX_RETRIES=3
